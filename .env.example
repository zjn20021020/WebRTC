# Tencent Cloud ASR V2, billed against the large-model 2.0 resource package.
# Use 8k_zh only with a standard real-time ASR package. Packages are not shared.
# AppID: https://console.cloud.tencent.com/developer
# API keys: https://console.cloud.tencent.com/cam/capi
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_MODEL=16k_zh_en_2.0

# Tencent TextToStreamAudioWS: 8kHz PCM; reuses all three credentials above.
# 101016: Tencent Zhitian child voice (approximation for Dimo, not the official voice).
TENCENT_TTS_VOICE_TYPE=101016

# DeepSeek OpenAI-compatible API. Root, /v1, or /chat/completions URL.
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
